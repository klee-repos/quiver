# Secrets
.env

# Per-user strategy book — your macro allocations + the derived trading universe. Kept
# private so a public repo never exposes your holdings. Copy strategy.yaml.example to
# start; on the box it's pulled from Secret Manager (see DEPLOY.md). config.yaml carries NO secrets
# (those are in .env) and IS committed.
strategy.yaml

# Per-box evolving strategy narrative — the bot appends dated learning notes to §7 on each
# review, so the live copy diverges from the repo. Untracked so a code sync (update.sh's
# clean-tree check) can never block on it or clobber it; a fresh box seeds it from the
# committed STRATEGY.md.example (setup.sh). Not secret — just per-box, like strategy.yaml.
STRATEGY.md

# Runtime state & logs
state/
logs/
KILL

# Editor / local
.vscode/

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.gstack/

# Deploy secrets / local state (only the *.example + IaC are tracked)
deploy/runner/runner.env
deploy/runner/mcp.json
deploy/gcp/terraform/terraform.tfvars
deploy/gcp/terraform/*.tfstate
deploy/gcp/terraform/*.tfstate.*
deploy/gcp/terraform/.terraform/
deploy/gcp/terraform/.terraform.lock.hcl
.claude/
# CLAUDE.md is kept LOCAL-ONLY — it carries the live ops runbook incl. the desktop PIN +
# quiver password. The repo is public, so it must never be committed.
CLAUDE.md

.full-send/

# EVE brain — local dev-runtime/compile cache (snapshots, cache, generated
# artifacts) + workflow lock/hook state. Never committed; regenerated by `eve`
# on the box. Source lives in quiver_eve/agent, quiver_eve/run, quiver_eve/test.
quiver_eve/.eve/
quiver_eve/.workflow-data/
