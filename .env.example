# Copy to .env and fill in. .env is gitignored. chmod 600 .env

# Required — your GLM 5.2 (z.ai) API key (the deep/reasoner role: debates/judgment).
GLM_API_KEY=

# Required — your DeepSeek API key (the quick/chat role: the analysts' tool-calling,
# i.e. "managing the agents", runs deepseek-v4-flash). Both providers are used.
DEEPSEEK_API_KEY=

# Required — your agentic_allowed=true Robinhood account number. Kept out of the
# committed config.yaml; lib/config.py reads it from here at load time.
RH_ACCOUNT_NUMBER=

# Required only when notify.enabled: true in config.yaml — email digest
# recipients, comma-separated (e.g. you@example.com,other@example.com).
NOTIFY_TO=

# --- Python last-resort alert sender (deploy/runner/run_tick.py) -------------
# These power the OUT-OF-TICK pager: when the headless orchestrator crashes,
# times out, or preflight errors, run_tick.py emails you directly via the Resend
# HTTP API (the in-tick MCP path can't — the process that would send is dead).
# REQUIRED on the production box for orchestrator-crash paging; if unset the
# last-resort sender stays disabled and only the in-tick MCP emails work.
#   RESEND_API_KEY — your Resend API key (same one the Resend MCP uses).
#   RESEND_FROM    — a sender on a Resend-VERIFIED domain (e.g. quiver@yourdomain.com).
#                    The HTTP API has no implicit sender; a blank from is a no-send.
# Verify it works after deploy:  .venv/bin/python tick.py send-test --kind auth_error
RESEND_API_KEY=
RESEND_FROM=

# Optional — route critical alerts to a separate pager list (comma-separated).
# Falls back to NOTIFY_TO when unset.
# NOTIFY_ALERTS_TO=
# Optional — host hint shown in alert "what to do" copy (e.g. ubuntu@1.2.3.4).
# QUIVER_HOST_HINT=

# Optional — NOT needed by default. Finance data (prices, indicators, fundamentals,
# news) comes from yfinance, which is keyless. Only set this if you switch
# config.yaml `data_vendors` from yfinance to Alpha Vantage. Leave blank otherwise.
# ALPHA_VANTAGE_API_KEY=
