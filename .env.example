# Copy to .env and fill in. .env is gitignored. chmod 600 .env
# deploy/gcp/bootstrap-gcp.sh runs this file with bash (`set -a; . ./.env`). Quote a value
# with a space, or bash runs the second word as a command.

# --- Claude Code auth --------------------------------------------------------
# The subscription token from `claude setup-token`. It is valid one year. The box reads it
# from Secret Manager (quiver-CLAUDE_CODE_OAUTH_TOKEN); bootstrap-gcp.sh pushes it.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Broker ------------------------------------------------------------------
# Required — your agentic_allowed=true Robinhood account number. Kept out of the
# committed config.yaml; lib/config.py reads it from here at load time.
RH_ACCOUNT_NUMBER=

# --- Telegram (the desk chat, the outbox, and every page) --------------------
# Required. The chat bridge is the only process that polls the bot.
#   TELEGRAM_BOT_TOKEN        — from @BotFather (/newbot).
#   TELEGRAM_ALLOWED_CHAT_IDS — numeric chat id(s) of the owner, comma-separated.
#   TELEGRAM_ALERT_CHAT_IDS   — optional override for page recipients; falls back
#                               to TELEGRAM_ALLOWED_CHAT_IDS when unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALERT_CHAT_IDS=

# --- SEC EDGAR ---------------------------------------------------------------
# Required. "Quiver" plus your contact email. SEC refuses a request without it. Keep
# the quotes: the value has a space.
SEC_USER_AGENT="Quiver you@example.com"

# --- Alpha Vantage -----------------------------------------------------------
# Optional. Earnings-call transcripts. The free key allows 25 calls a day.
# Get one at https://www.alphavantage.co/support/#api-key.
ALPHA_VANTAGE_API_KEY=

# --- Models (optional; the code holds these defaults) ------------------------
# Set one only to override it.
# QUIVER_DESK_MODEL=claude-sonnet-5-5
# QUIVER_ANALYST_MODEL=claude-opus-5-5
# QUIVER_CLASSIFIER_MODEL=claude-haiku-5-5
# QUIVER_BROKER_MODEL=claude-sonnet-5-5

# Optional — host hint shown in alert "what to do" copy (e.g. ubuntu@1.2.3.4).
# QUIVER_HOST_HINT=
