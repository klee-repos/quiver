# Copy to .env and fill in. .env is gitignored. chmod 600 .env

# --- EVE brain (the analysis backend) ---------------------------------------
# The brain runs GLM via OpenRouter — a single OpenAI-compatible gateway fronting
# both roles with ONE key. This is the only LLM key the live brain reads (EVE wiring
# is in quiver_eve/agent/agent.ts + quiver_eve/run/decide.mjs, not config.yaml).
#   OPENROUTER_API_KEY — required. Get one at https://openrouter.ai/keys.
# Models are OpenRouter slugs, env-overridable (defaults shown):
#   QUIVER_REASONER_MODEL (default z-ai/glm-5.2)      — deep/PM role, reasoning ON
#   QUIVER_CHAT_MODEL     (default z-ai/glm-4.7-flash) — quick/subagent role (analysts, debators)
# Leave the two model vars unset to use the defaults.
OPENROUTER_API_KEY=
# QUIVER_REASONER_MODEL=
# QUIVER_CHAT_MODEL=
# Optional — override the OpenRouter endpoint (e.g. a mirror). Defaults to the public API.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Legacy LLM keys (ROLLBACK ONLY — not read by the EVE brain) -------------
# Kept here as a fallback in case OpenRouter is dropped and the brain is rewired
# to the providers directly. The EVE brain does NOT read these; leave blank if you
# only run the EVE brain.
# GLM_API_KEY=
# DEEPSEEK_API_KEY=

# --- Broker ------------------------------------------------------------------
# Required — your agentic_allowed=true Robinhood account number. Kept out of the
# committed config.yaml; lib/config.py reads it from here at load time.
RH_ACCOUNT_NUMBER=

# --- Telegram alerts + read-only chat bridge --------------------------------
# ALL alerting (daily digest + halt/auth_error/error) goes to Telegram via the
# bot — a plain HTTPS POST (lib.telegram), no MCP, no OAuth. The SAME bot powers
# the read-only "chat with Quiver" bridge (docs/CHAT.md). Required only when
# notify.enabled: true in config.yaml.
#   TELEGRAM_BOT_TOKEN      — from @BotFather (/newbot).
#   TELEGRAM_ALLOWED_CHAT_IDS — numeric chat id(s) for the chat bridge.
#   TELEGRAM_ALERT_CHAT_IDS — optional override for alert recipients; falls back
#                             to TELEGRAM_ALLOWED_CHAT_IDS when unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# TELEGRAM_ALERT_CHAT_IDS=
# Verify an alert after deploy:  .venv/bin/python tick.py send-test --kind auth_error

# --- Legacy email/Resend (ROLLBACK ONLY — not used by the live alert path) ---
# Notifications moved to Telegram on 2026-07-19. The Resend HTTP sender
# (lib/mailer.py) + NOTIFY_TO digest recipients are kept only as a rollback.
NOTIFY_TO=
RESEND_API_KEY=
RESEND_FROM=

# Optional — host hint shown in alert "what to do" copy (e.g. ubuntu@1.2.3.4).
# QUIVER_HOST_HINT=

# --- Legislative catalyst (Congress.gov API) ---------------------------------
# Required only when config.yaml `legislative.enabled: true`. Free api.data.gov key
# for the Congress.gov bill-ingest feed. Get one at https://api.congress.gov/sign-up/.
# Absent -> the legislative phase no-ops (no bills, no proposals); it never blocks a tick.
# CONGRESS_API_KEY=

# --- Optional data vendor ----------------------------------------------------
# NOT needed by default. Finance data (prices, indicators, fundamentals, news)
# comes from yfinance, which is keyless. Only set this if you switch
# config.yaml `data_vendors` from yfinance to Alpha Vantage. Leave blank otherwise.
# ALPHA_VANTAGE_API_KEY=
