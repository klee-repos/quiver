# Copy to .env and fill in. .env is gitignored. chmod 600 .env
DEEPSEEK_API_KEY=

# Optional — NOT needed by default. Finance data (prices, indicators, fundamentals,
# news) comes from yfinance, which is keyless. Only set this if you switch
# config.yaml `data_vendors` from yfinance to Alpha Vantage. Leave blank otherwise.
# ALPHA_VANTAGE_API_KEY=
