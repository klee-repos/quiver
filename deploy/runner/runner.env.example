# Copy to /etc/quiver/quiver.env (chmod 600, owned by the quiver service user).
# In production deploy/gcp/setup.sh fetches these from Google Secret Manager at provision
# time and writes this file; the units read it with systemd EnvironmentFile=.
# NEVER commit the filled-in file — only this .example is tracked.
#
# Write each value as KEY="value". systemd and bash both read that form, and a value with a
# space (SEC_USER_AGENT) needs the quotes. A value must not hold ", \, $ or a backtick.
#
# Do NOT set CLAUDE_CONFIG_DIR here. Each unit that runs Claude sets it with Environment=,
# and EnvironmentFile= overrides Environment= (systemd.exec(5)). A value here would move the
# desk and the analyst onto the Robinhood OAuth dir.

# --- Claude Code auth (required) ---
# The subscription token from `claude setup-token` on a laptop. It is valid one year. Every
# Claude process (desk, analyst, classifier, broker) and the update gate use it.
CLAUDE_CODE_OAUTH_TOKEN="sk-ant-oat..."
# The pinned service binary (quiver-claude-update keeps it current).
CLAUDE_BIN="/opt/quiver/npm-global/bin/claude"

# --- Robinhood (required) ---
RH_ACCOUNT_NUMBER="..."                # the agentic_allowed account; only the broker child reads it
# There is NO Robinhood token here. The Robinhood MCP authenticates with OAuth, stored under
# /opt/quiver/state/claude-config (quiver-broker only). Re-auth from a laptop with
# deploy/gcp/rh-reauth.sh when the AUTH_ERROR page arrives.

# --- Telegram (required) ---
# The chat bridge is the only poller. The outbox and every page send through the same bot.
TELEGRAM_BOT_TOKEN="123456:ABC..."             # from @BotFather
TELEGRAM_ALLOWED_CHAT_IDS="123456789"          # your numeric chat id(s), comma-separated — the
                                               # ONLY accounts allowed to talk to the bot
# TELEGRAM_ALERT_CHAT_IDS="123456789"          # optional: page-only chat id(s); falls back to
#                                              # TELEGRAM_ALLOWED_CHAT_IDS

# --- SEC EDGAR (required) ---
# "Quiver" plus the owner's contact email. lib/desk/edgar.py sends it as the User-Agent.
SEC_USER_AGENT="Quiver you@example.com"

# --- Alpha Vantage (optional) ---
# Earnings-call transcripts (lib/desk/transcripts.py). The free key allows 25 calls a day.
# ALPHA_VANTAGE_API_KEY="..."

# --- Models (optional; the code holds these defaults) ---
# Set one only to override it.
# QUIVER_DESK_MODEL="claude-sonnet-5-5"        # the desk agent (quiver-chat)
# QUIVER_ANALYST_MODEL="claude-opus-5-5"       # analyst jobs (quiver-worker)
# QUIVER_CLASSIFIER_MODEL="claude-haiku-5-5"   # news classifier + quick reaction
# QUIVER_BROKER_MODEL="claude-sonnet-5-5"      # the broker runbooks (quiver-broker)
