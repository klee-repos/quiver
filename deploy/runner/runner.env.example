# Copy to /etc/quiver/quiver.env (chmod 600, owned by the quiver service user).
# In production setup.sh fetches these from AWS SSM Parameter Store at provision
# time and writes this file; the app reads plain env via systemd EnvironmentFile.
# NEVER commit the filled-in file — only this .example is tracked.

# --- model + DeepSeek (required) ---
ANTHROPIC_API_KEY=sk-ant-...           # drives the headless `claude` orchestration loop
DEEPSEEK_API_KEY=sk-...                # the analyze.py multi-agent signal

# --- Robinhood (required for live trading) ---
RH_ACCOUNT_NUMBER=...                  # the agentic_allowed account
RH_OAUTH_TOKEN=...                     # bearer for the Robinhood MCP (NO refresh — re-auth is manual; decision D10)

# --- email digest (optional; Resend MCP) ---
RESEND_API_KEY=re_...
NOTIFY_TO=you@example.com

# --- runner knobs (optional; sensible defaults in run_tick.py) ---
QUIVER_MODEL=claude-haiku-4-5-20251001
QUIVER_EFFORT=low
QUIVER_TICK_TIMEOUT_SEC=2400
