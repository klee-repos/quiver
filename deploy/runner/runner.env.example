# Copy to /etc/quiver/quiver.env (chmod 600, owned by the quiver service user).
# In production deploy/gcp/setup.sh fetches these from Google Secret Manager at provision
# time and writes this file; the app reads plain env via systemd EnvironmentFile.
# NEVER commit the filled-in file — only this .example is tracked.

# --- Claude Code auth for the headless orchestrator (OPTIONAL) ---
# Either provide a token here, OR just `claude login` once in the on-box desktop (Chrome
# Remote Desktop) — the headless tick reuses that session via CLAUDE_CONFIG_DIR below.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...  # Pro/Max subscription token (no API billing)
# ANTHROPIC_API_KEY=sk-ant-...           # ...or API billing (do NOT set both)

# --- Shared claude/MCP credential + OAuth store (required on the box) ---
# Writable, refreshable, under /opt/quiver/state so it survives ProtectHome=read-only. The
# Robinhood OAuth done in the on-box browser and the headless tick BOTH read this dir.
CLAUDE_CONFIG_DIR=/opt/quiver/state/claude-config

# --- EVE brain (OpenRouter) — required ---
OPENROUTER_API_KEY=...                 # the live analyze.py/EVE-brain key (GLM via OpenRouter)
# QUIVER_REASONER_MODEL=z-ai/glm-5.2       # optional override; defaults shown
# QUIVER_CHAT_MODEL=z-ai/glm-4.7-flash

# --- Robinhood (required for live trading) ---
RH_ACCOUNT_NUMBER=...                  # the agentic_allowed account
# NOTE: there is NO RH_OAUTH_TOKEN any more — the Robinhood MCP authenticates via OAuth done
# once in the on-box browser (`/mcp`), stored under CLAUDE_CONFIG_DIR. Re-auth ~every 3.8d.

# --- alerts + daily digest (Telegram) ---
# ALL alerting (daily digest + halt / auth_error / error pages) now goes to Telegram via the bot —
# a plain HTTPS POST, no MCP, no email. The bot token + chat id are the SAME secrets the read-only
# chat bridge uses (below), so once those are provisioned the alert path needs NOTHING extra.
# TELEGRAM_BOT_TOKEN + a chat id must reach THIS file (/etc/quiver/quiver.env) for alerts to fire;
# validate on the box with `tick.py send-test` (the deploy acceptance gate).
# TELEGRAM_ALERT_CHAT_IDS=123456789    # optional: alert-only chat id(s); falls back to
#                                      # TELEGRAM_ALLOWED_CHAT_IDS (the chat-bridge allowlist) below
# --- email (LEGACY / rollback only — unused by the live alert path) ---
# RESEND_API_KEY=re_...                # kept only so a rollback to the email sender needs no re-provision
# RESEND_FROM=quiver@yourdomain.com
# NOTIFY_TO=you@example.com            # email recipients (no longer sent to; parsed but not validated)
# NOTIFY_ALERTS_TO=pager@example.com

# --- runner knobs (optional; sensible defaults in run_tick.py) ---
QUIVER_MODEL=claude-haiku-4-5-20251001
QUIVER_EFFORT=low
QUIVER_TICK_TIMEOUT_SEC=2400

# --- read-only Telegram chat bridge (OPTIONAL; deploy/quiver-chat.service) ---
# Chat with the bot from your phone: "how did today's run go?", "trace decision 142", etc.
# Both unset => the bridge stays idle. It is STRICTLY read-only (no broker, no writes). Setup
# steps (create the bot, find your chat id) are in docs/CHAT.md.
# TELEGRAM_BOT_TOKEN=123456:ABC...             # from @BotFather
# TELEGRAM_ALLOWED_CHAT_IDS=123456789          # your numeric chat id(s), comma-separated — the
#                                              # ONLY accounts allowed to talk to the bot
# QUIVER_CHAT_MODEL=claude-sonnet-4-6          # model for chat answers (defaults to QUIVER_MODEL)
# QUIVER_CHAT_EFFORT=medium
# QUIVER_CHAT_TIMEOUT_SEC=240
