# All variables have working defaults in variables.tf — `terraform apply` works with NO
# tfvars. Copy this to terraform.tfvars only to override (e.g. a different project/region).
# None of these are secrets (the public repo URL, project id, region, email), so committing
# a filled-in terraform.tfvars is harmless if you prefer.
project      = "your-gcp-project-id"
region       = "us-central1"
zone         = "us-central1-a"
machine_type = "e2-medium"
repo_url     = "https://github.com/klee-repos/quiver.git" # public — HTTPS clone, no key
alert_email  = "ops@yourdomain.com"
