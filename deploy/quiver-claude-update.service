[Unit]
Description=Quiver — keep every Claude Code install current
After=network-online.target
Wants=network-online.target
# Never update under a running job. The monitor runs 11:40 to 23:40 UTC. This runs at
# 05:00 UTC. claude-update.sh skips the day while the worker or the broker is active.
# Do NOT use Conflicts= here. It makes systemd KILL a running unit, maybe a broker run
# between place_equity_order and commit. After= only orders the units if they coincide.
# It never stops a run.
After=quiver.service quiver-worker.service quiver-broker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/quiver-claude-update
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
