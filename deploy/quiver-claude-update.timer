[Unit]
Description=Quiver — daily Claude Code update (well before the market opens)

[Timer]
# 05:00 UTC: after the last monitor run (23:40 UTC) and before the first (11:40 UTC).
# claude-update.sh pauses the broker and worker triggers during the binary swap.
OnCalendar=*-*-* 05:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
