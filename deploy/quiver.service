[Unit]
Description=Quiver — one headless trading tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quiver
Group=quiver
WorkingDirectory=/opt/quiver
EnvironmentFile=/etc/quiver/quiver.env
# Clean per-tick status lines also go to this file (stdout still goes to journald),
# so the Cloud Logging Ops Agent can tail it and the log-based metric alarms have data. It sits
# under ReadWritePaths below; locally run_tick.py defaults to logs/tick.log instead.
Environment=QUIVER_TICK_LOG=/var/log/quiver/tick.log
# CLAUDE_CONFIG_DIR comes from quiver.env (=/opt/quiver/state/claude-config) — a writable
# ReadWritePath, so claude/MCP OAuth state is readable+refreshable even under ProtectHome.
# Keep npx's cache (the resend MCP runs `npx -y resend-mcp`) off the read-only HOME too,
# else the in-tick digest send silently fails.
Environment=npm_config_cache=/opt/quiver/state/.npm-cache
ExecStart=/opt/quiver/.venv/bin/python /opt/quiver/deploy/runner/run_tick.py
# Outer guard only. STEP 3 now BLOCKS on the full-book analysis (~11 GLM runs; a slow,
# retry-heavy day can run 60-90 min — see run_tick.py). Keep this ABOVE run_tick.py's own 4h
# (14400s) internal backstop so run_tick's timeout fires first and pages a clean alert rather
# than systemd SIGTERM-ing a legit slow tick. Overlapping hourly fires no-op via the run_lock.
TimeoutStartSec=15000
StandardOutput=journal
StandardError=journal
# Hardening (mirrors BRAX): the tick may only write its own state/logs. ProtectHome stays
# read-only — all writable claude/MCP/npm state is redirected under /opt/quiver/state above.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/quiver/state /opt/quiver/logs /var/log/quiver
# 4 GiB box (e2-medium); the tick spawns claude + analyze.py subprocesses. The XFCE/Chrome
# desktop runs OUTSIDE this unit and can be ~1.5 GiB during a re-auth, so cap the tick at
# 2500M to leave physical headroom (a 2G swapfile, added in deploy/gcp/setup.sh, absorbs any spike).
MemoryMax=2500M
