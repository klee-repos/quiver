[Unit]
Description=Quiver — nightly ledger backup (after the last tick of the day)

[Timer]
# 22:15 UTC, every day: the chat bridge and the worker write the ledger on weekends too.
# The upload uses the SQLite backup API, so a monitor run or a chat turn at the same
# time is safe.
OnCalendar=*-*-* 22:15:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
