# strategy.yaml — EXAMPLE. Copy to strategy.yaml (gitignored) and encode YOUR book:
#   cp strategy.yaml.example strategy.yaml
# strategy.yaml is your macro book + goal as DATA (not prose). It's per-user and NOT
# committed, so your real allocations/thesis stay private. The values below are an
# ILLUSTRATIVE template — replace the thesis, universe, and weights with your own.
#
# `tick.py strategy-set` writes this into the ledger (strategy_goal + target_portfolio);
# `tick.py construct` reads the LEDGER at runtime. So: yaml = source, ledger = runtime
# state. There is no third copy.
#
# Zero secrets here (like config.yaml). Fails SAFE: an absent or garbled strategy.yaml
# leaves cfg.strategy=None -> the whole strategy layer is INACTIVE (construct returns
# proceed:false; analyze.py + cmd_plan behave exactly as the validated once-a-day
# path). It NEVER auto-switches to the riskier dial-up book.
#
# All trading/sizing/rebalance decisions still live in deterministic Python
# (lib/strategy, lib/portfolio, lib/signals). This file only supplies the target
# weights + macro thesis the Python brain consumes.
schema: 1

# --- The goal ---------------------------------------------------------------
goal:
  target_return_pct: 15            # beat +N% total return over the horizon...
  horizon_months: 12               # ...within N months, else hold cash.
  benchmark: "SGOV ~3.6%"          # the "do nothing" alternative we must beat
  benchmark_annual_pct: 3.6        # linearized daily-prorated for per-decision alpha
  constraint: "Robinhood-tradable only; crypto allowed; cash is the only ballast"

# --- The macro thesis (operator DATA; the bot cannot fetch macro) -----------
# Replace with YOUR read. The core-PCE / Fed readings are supplied by the operator
# (macro_state) — Python selects the book deterministically from them; it never
# reasons about macro.
macro_thesis:
  version: "2026-01-01"
  summary: >
    <Your macro thesis here.> Example: base case across sleeves ~+6%; the target is
    only reached in a bull-tilted year; name the single catalyst that lights your
    risk sleeves at once.
  catalysts_to_watch:
    - "<next FOMC + dot plot>"
    - "<next core PCE>"
    - "<next CPI>"
  deploy_trigger_pce_pct: 2.5      # core PCE <= this -> DEPLOY regime (recommend dial-up)
  standdown_trigger_pce_pct: 3.5   # core PCE >= this -> STAND DOWN (de-risk to core/cash)
  standdown_on_hike: true          # a confirmed Fed hike also forces STAND DOWN
  correlation_note: >
    <Note any sleeves that are really ONE bet and fall together — they do NOT
    diversify each other.>

# --- The Robinhood-tradable universe (allow-list; add/remove gate) -----------
# A proposed ADD must be on this list AND quotable via the equities MCP. These are
# illustrative broad ETFs — swap in your own universe.
# NOTE: the optional legislative-catalyst feature (config.yaml `legislative:`) can only
# ever PROPOSE_ADD a name that is ALREADY on this human-vetted list — a bill can never
# introduce an off-list ticker. So to let a catalyst reach a name (e.g. defense/energy/
# semis), add it here (illustrative catalyst names shown: LMT, RTX, FSLR, ENPH, SMH).
rh_tradable_confirmed:
  [QQQ, RSP, XLV, EEM, XLE, AVUV, IBIT, ETHA, SGOV, LMT, RTX, FSLR, ENPH, SMH]

# The legislative-catalyst sleeve is a plain HOLDING LABEL ("Legislative Catalyst") — it is
# intentionally NOT listed under `sleeves:` below, because a `screen:` there would switch on
# the generic momentum screener and auto-add names with no bill/judge. A catalyst ADD's target
# weight comes from config.yaml `legislative.add_weight`, not a sleeve screen.
# To enable suffer->REMOVE (config.yaml `legislative.remove_enabled: true`), map each held name
# to the Congress policy codes that make a bill RELEVANT to it, in config.yaml, e.g.:
#   legislative: { ticker_policy_areas: { LMT: ["Armed Forces and National Security"],
#                                         FSLR: ["Energy"] } }

# --- The books --------------------------------------------------------------
# core is the DEFAULT, validated active book. dial_up is OFF; ACTIVATING dial-up
# requires flipping enabled:true (fail-safe, like dry_run). quotable:false marks a
# holding the equities MCP can't price (e.g. spot crypto) -> construct skips it from
# the executable book; its weight is held in cash. Weights below are ILLUSTRATIVE.
books:
  core_60_40:
    default: true
    holdings:
      - {sleeve: "US large cap",     ticker: QQQ,  weight: 20, band: 5}
      - {sleeve: "US equal weight",  ticker: RSP,  weight: 10, band: 4}
      - {sleeve: "Value/Defensive",  ticker: XLV,  weight: 12, band: 4}
      - {sleeve: "Emerging markets", ticker: EEM,  weight: 8,  band: 3}
      - {sleeve: "Crypto BTC",       ticker: IBIT, weight: 6,  band: 3}
      - {sleeve: "Crypto ETH",       ticker: ETHA, weight: 4,  band: 2}
      - {sleeve: "Cash",             ticker: SGOV, weight: 40}   # residual ballast
  dial_up:
    enabled: false        # OFF; activating dial-up requires this flag
    holdings:
      - {sleeve: "US large cap",     ticker: QQQ,  weight: 32, band: 6}
      - {sleeve: "US equal weight",  ticker: RSP,  weight: 8,  band: 3}
      - {sleeve: "Value/Defensive",  ticker: XLV,  weight: 10, band: 4}
      - {sleeve: "Emerging markets", ticker: EEM,  weight: 10, band: 4}
      - {sleeve: "Crypto BTC",       ticker: IBIT, weight: 8,  band: 3}
      - {sleeve: "Crypto ETH",       ticker: ETHA, weight: 4,  band: 2}
      - {sleeve: "Cash",             ticker: SGOV, weight: 28}

# --- Sleeves: the STRATEGY (durable) vs the STOCKS (evolvable) ---------------
# SEED-THEN-EVOLVE (owner decision): a sleeve is a slot in the strategy — its target
# weight + band (in `books` above) and its `screen` criteria here ARE the strategy.
# WHICH ticker fills a sleeve is the evolvable universe: SEEDED by the `books` holdings,
# then OWNED by the ledger and rotated over time by the screener (PROPOSE_ADD within
# these criteria) + the underperformer REMOVE path. So "same strategy != same stocks".
# `screen` is read by lib/screener to discover candidates (yfinance, no new API key);
# a sleeve with no `screen` is never auto-discovered (its seeded ticker stays) — so
# discovery is enabled by DATA (define a `screen`), not a flag. The screener PROPOSES
# adds every learning review; APPLYING one still needs human `--approve` by default
# (auto_apply_universe_changes). market_cap in USD; pe_max / momentum_window optional.
sleeves:
  "US large cap":
    screen: {sector: "Technology", market_cap_min: 50000000000, pe_max: 60, momentum_window: 60}
  "Value/Defensive":
    screen: {sector: "Healthcare", market_cap_min: 20000000000, pe_max: 30}
  # Cash / Crypto / broad-ETF sleeves intentionally omit `screen` -> no auto-discovery.

# --- Allocation policy (Q1): how CONVICTION becomes target weight ------------
# Read by lib/allocate (conviction sizing is ALWAYS ON). These are the operator's sizing
# guardrails (the strategy, not the stocks). Every key is optional (lib/allocate has safe
# fallbacks). Conviction can tilt a name UP only within per_name_max_pct/sleeve_max_pct
# and never past the dollar caps; an all-Hold tick falls back to the static book exactly.
# Set these to accommodate your book (e.g. per_name_max_pct >= your largest holding) so a
# quiet tick is never re-clipped.
risk_policy:
  per_name_max_pct: 20         # no single name above this % of the book (conviction can't breach it)
  sleeve_max_pct: 45           # no single sleeve above this %
  cash_floor_pct: 5            # always hold >= this % cash (a HARD floor)
  conviction_curve_k: 1.0      # >1 sharpens into best ideas; 1.0 = linear
  smoothing_alpha: 0.4         # EWMA weight on TODAY's target (lower = stickier day-to-day)
  uncertainty_damp: 0.5        # how much self-reported uncertainty shrinks conviction
  regime_min_factor: 0.5       # most a STAND_DOWN regime can cut deployment toward cash

# --- Continual-learning gates (Stage 4) -------------------------------------
# Every universe-touching gate defaults SAFE; both auto_apply_* default FALSE (the
# investable universe stays human-gated unless explicitly opened).
learning:
  underperf_window: 8
  underperf_hit_floor: 0.40
  underperf_mean_floor: 0.0
  min_resolved_n: 5
  sleeve_review_min_n: 6
  derisk_on_standdown: true
  auto_apply_derisk: false              # safe direction; still OFF by default
  auto_apply_universe_changes: false    # auto-APPLY universe changes (incl. screener ADDs) without
                                        #   human approval — risky; OFF = the screener proposes, you --approve
  goal_gap_derisk_pct: -5.0
  proposal_expiry_days: 5

# --- Strategic-change consistency (Component C/D/E) -------------------------
# Makes PORTFOLIO-construction changes strategic, infrequent, and proof-backed:
#   * the macro REGIME (which drives the book recommendation + the DERISK proposal)
#     only flips after a dead-banded reading is CONFIRMED N times and a min-dwell has
#     elapsed — so a single noisy PCE print can't swing the posture;
#   * an AUTO universe REMOVE/DERISK must RECUR on N distinct days and re-validate its
#     underperformance proof at apply time, and a rejected/applied change is suppressed
#     for a cooldown window (no propose->reject->propose oscillation).
# All defaults below match the code defaults; omit the block to use them.
consistency:
  regime_confirm_n: 2                   # consecutive confirming readings before the regime flips
  regime_min_dwell_days: 5              # min days an effective regime holds before it can change
  regime_deadband_pce: 0.1              # band (core-PCE %) around the deploy/standdown triggers
  proposal_cooldown_days: 5             # suppress re-proposing a change decided within this window
  universe_confirm_days: 2              # distinct days a REMOVE/DERISK must recur to auto-apply
  min_strategy_set_interval_days: 0     # informational note when strategy-set re-runs sooner (0 = off)
